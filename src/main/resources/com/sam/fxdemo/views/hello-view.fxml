<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="app-shell" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sam.fxdemo.HelloController">
    <HBox styleClass="top-bar">
        <padding>
            <Insets bottom="10.0" left="18.0" right="18.0" top="14.0"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="12.0" prefWidth="300.0">
            <Label styleClass="brand-mark" text="WFM"/>
            <VBox spacing="1.0">
                <Label styleClass="brand-title" text="WFM Platform"/>
                <Label styleClass="brand-subtitle" text="Workforce Management Ecosystem"/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="search-box" prefWidth="520.0">
            <Label styleClass="search-icon" text="Search"/>
            <Label styleClass="search-text" text="Search for modules, reports, users, settings..."/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label styleClass="keycap" text="Ctrl + K"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS" minWidth="18.0"/>
        <Button styleClass="assistant-button" text="AI Assistant"/>
        <Button styleClass="top-icon-button" text="Alerts 12"/>
        <Button styleClass="top-icon-button" text="Chat"/>
        <Button styleClass="top-icon-button" text="Help"/>
        <Button styleClass="top-icon-button" text="Settings"/>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="profile-chip">
            <Label styleClass="avatar" text="JD"/>
            <VBox spacing="0.0">
                <Label styleClass="profile-name" text="John Doe"/>
                <Label styleClass="profile-role" text="WFM Admin"/>
            </VBox>
        </HBox>
    </HBox>

    <HBox VBox.vgrow="ALWAYS">
        <VBox fx:id="sidebar" prefWidth="226.0" minWidth="226.0" maxWidth="226.0" styleClass="sidebar">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="nav-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="7.0" styleClass="nav-content">
                    <Label fx:id="navSectionLabel" styleClass="nav-section" text="CORE OPERATIONS"/>
                    <Button fx:id="dashboardNavButton" onAction="#onDashboardNavClick" styleClass="nav-button" text="WFM Dashboard"/>
                </VBox>
            </ScrollPane>
            <Button fx:id="collapseButton" onAction="#onCollapseButtonClick" styleClass="collapse-button" text="Collapse Menu"/>
        </VBox>

        <VBox styleClass="workspace" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="dashboard-toolbar">
                <Label styleClass="workspace-title" text="WFM DASHBOARD"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="dateFilterCombo" prefWidth="185.0" promptText="23 May 2026 (Sat)"/>
                <ComboBox fx:id="teamFilterCombo" prefWidth="150.0" promptText="LOB: All"/>
                <ComboBox fx:id="agentFilterCombo" prefWidth="150.0" promptText="Site: All"/>
                <ComboBox prefWidth="172.0" promptText="Granularity: 15 Min"/>
                <Button fx:id="apiStatusButton" onAction="#onApiStatusButtonClick" styleClass="outline-button" text="Refresh"/>
                <Button fx:id="uploadButton" onAction="#onUploadButtonClick" styleClass="edit-button" text="Edit Dashboard"/>
                <Button styleClass="square-button" text="Full"/>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS">
                <ScrollPane fx:id="dashboardScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="dashboard-scroll">
                    <content>
                <VBox fx:id="dashboardPage" spacing="14.0" styleClass="dashboard-page">
                    <!-- Key Health Indicators Panel -->
                    <VBox spacing="10.0" styleClass="panel">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="panel-title" text="KEY HEALTH INDICATORS"/>
                            <Label styleClass="panel-subtitle" text="(Click any card to drill into module)"/>
                        </HBox>
                        <VBox spacing="10.0">
                            <!-- Row 1 -->
                            <HBox spacing="10.0">
                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <Label styleClass="kpi-label" text="REQ COVER"/>
                                    <Label fx:id="coverageValueLabel" styleClass="kpi-value" text="0.0%"/>
                                    <Label styleClass="kpi-target" text="Target: 100%"/>
                                    <Label fx:id="reqCoverIndLabel" styleClass="positive-text" text="-"/>
                                </VBox>
                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <Label styleClass="kpi-label" text="SCH EFFIC"/>
                                    <Label fx:id="schEfficValLabel" styleClass="kpi-value" text="0.0%"/>
                                    <Label styleClass="kpi-target" text="Target ≥75%"/>
                                    <Label fx:id="schEfficIndLabel" styleClass="positive-text" text="-"/>
                                </VBox>
                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <Label styleClass="kpi-label" text="ADHERENCE"/>
                                    <Label fx:id="adherenceValLabel" styleClass="kpi-value" text="0.0%"/>
                                    <Label styleClass="kpi-target" text="Target ≥95%"/>
                                    <Label fx:id="adherenceIndLabel" styleClass="positive-text" text="-"/>
                                </VBox>
                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <Label styleClass="kpi-label-warning" text="ATTRITION"/>
                                    <Label fx:id="attritionValLabel" styleClass="kpi-value" text="0.0% ann"/>
                                    <Label styleClass="kpi-target" text="Prev: 7.8%"/>
                                    <Label fx:id="attritionIndLabel" styleClass="warning-count" text="-"/>
                                </VBox>
                            </HBox>
                            <!-- Row 2 -->
                            <HBox spacing="10.0">
                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <Label styleClass="kpi-label" text="FCA"/>
                                    <Label fx:id="fcaValLabel" styleClass="kpi-value" text="0.0%"/>
                                    <Label styleClass="kpi-target" text="Prev: 84.1%"/>
                                    <Label fx:id="fcaIndLabel" styleClass="positive-text" text="-"/>
                                </VBox>
                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <Label styleClass="kpi-label" text="OCCUPANCY"/>
                                    <Label fx:id="occupancyValueLabel" styleClass="kpi-value" text="0.0%"/>
                                    <Label styleClass="kpi-target" text="Target &lt;85%"/>
                                    <Label fx:id="occupancyIndLabel" styleClass="positive-text" text="-"/>
                                </VBox>
                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <Label styleClass="kpi-label" text="IN-OFF SH"/>
                                    <Label fx:id="shrinkageValueLabel" styleClass="kpi-value" text="0.0%"/>
                                    <Label styleClass="kpi-target" text="Budget 12%"/>
                                    <Label fx:id="inOffShIndLabel" styleClass="positive-text" text="-"/>
                                </VBox>
                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <Label styleClass="kpi-label" text="GM EST"/>
                                    <Label fx:id="gmEstValLabel" styleClass="kpi-value" text="0.0%"/>
                                    <Label styleClass="kpi-target" text="Budget 35%"/>
                                    <Label fx:id="gmEstIndLabel" styleClass="warning-count" text="-"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Middle Row: 6-Month Coverage Trend and AI Recommendations split -->
                    <GridPane hgap="14.0" vgap="12.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints vgrow="ALWAYS"/>
                        </rowConstraints>

                        <!-- Left Panel: 6-Month Coverage Trend -->
                        <VBox spacing="8.0" styleClass="panel" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <HBox alignment="CENTER_LEFT">
                                <Label styleClass="panel-title" text="6-MONTH COVERAGE TREND"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button styleClass="tiny-select" text="Line Chart"/>
                            </HBox>
                            <HBox spacing="18.0">
                                <Label styleClass="legend-blue" text="Req Production Hrs"/>
                                <Label styleClass="legend-green" text="Cap Production Hrs"/>
                                <Label styleClass="legend-purple" text="Actuals" style="-fx-text-fill: #a855f7;"/>
                            </HBox>
                            <StackPane fx:id="serviceLevelChartPane" prefHeight="240.0" styleClass="chartfx-host" VBox.vgrow="ALWAYS"/>
                            <HBox spacing="10.0" alignment="CENTER" style="-fx-padding: 5 0 5 0;">
                                <VBox alignment="CENTER" spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label text="W23" style="-fx-font-weight: bold; -fx-text-fill: #a7b4c5;"/>
                                    <Label fx:id="w23CovLabel" text="--" style="-fx-text-fill: #eef5ff;"/>
                                </VBox>
                                <VBox alignment="CENTER" spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label text="W24" style="-fx-font-weight: bold; -fx-text-fill: #a7b4c5;"/>
                                    <Label fx:id="w24CovLabel" text="--" style="-fx-text-fill: #eef5ff;"/>
                                </VBox>
                                <VBox alignment="CENTER" spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label text="W25" style="-fx-font-weight: bold; -fx-text-fill: #a7b4c5;"/>
                                    <Label fx:id="w25CovLabel" text="--" style="-fx-text-fill: #eef5ff;"/>
                                </VBox>
                                <VBox alignment="CENTER" spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label text="W26" style="-fx-font-weight: bold; -fx-text-fill: #a7b4c5;"/>
                                    <Label fx:id="w26CovLabel" text="--" style="-fx-text-fill: #eef5ff;"/>
                                </VBox>
                                <VBox alignment="CENTER" spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label text="W27" style="-fx-font-weight: bold; -fx-text-fill: #a7b4c5;"/>
                                    <Label fx:id="w27CovLabel" text="--" style="-fx-text-fill: #eef5ff;"/>
                                </VBox>
                                <VBox alignment="CENTER" spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label text="W28" style="-fx-font-weight: bold; -fx-text-fill: #a7b4c5;"/>
                                    <Label fx:id="w28CovLabel" text="--" style="-fx-text-fill: #eef5ff;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Right Panel: AI Recommendations (Explainable) -->
                        <VBox spacing="8.0" styleClass="panel" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <HBox alignment="CENTER_LEFT">
                                <Label styleClass="panel-title" text="AI RECOMMENDATIONS (Explainable)"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button styleClass="link-button" text="View All"/>
                            </HBox>
                            <ScrollPane fitToWidth="true" styleClass="dashboard-scroll" VBox.vgrow="ALWAYS" prefHeight="230.0">
                                <VBox fx:id="recommendationsContainer" spacing="10.0" style="-fx-padding: 4 0 4 0;">
                                    <!-- Populated dynamically -->
                                </VBox>
                            </ScrollPane>
                            <Button onAction="#onExportRecommendationsClick" styleClass="outline-button" text="View All Recommendations"/>
                        </VBox>
                    </GridPane>

                    <!-- Bottom Row: Cross-Department Live Feed (Full Width) -->
                    <VBox spacing="8.0" styleClass="panel compact-panel">
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="panel-title" text="CROSS-DEPARTMENT LIVE FEED"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label styleClass="live-dot" text="● Live"/>
                        </HBox>
                        <VBox spacing="6.0" style="-fx-padding: 4 0 4 0;">
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="OPS" style="-fx-font-weight: bold; -fx-text-fill: #19d0ca; -fx-min-width: 90;"/>
                                <Label fx:id="opsLiveFeedLabel" text="SL today: 0.0% | AHT: 0s" style="-fx-text-fill: #edf4ff;"/>
                            </HBox>
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="FINANCE" style="-fx-font-weight: bold; -fx-text-fill: #ffa620; -fx-min-width: 90;"/>
                                <Label fx:id="financeLiveFeedLabel" text="Direct Cost/PPH: €0.00 | GM gap: 0.0pp" style="-fx-text-fill: #edf4ff;"/>
                            </HBox>
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="RECRUITMENT" style="-fx-font-weight: bold; -fx-text-fill: #b764ff; -fx-min-width: 90;"/>
                                <Label fx:id="recruitmentLiveFeedLabel" text="0 pending hire approvals | W26 NHT confirmed" style="-fx-text-fill: #edf4ff;"/>
                            </HBox>
                        </VBox>
                        <HBox spacing="10.0" style="-fx-padding: 4 0 0 0;">
                            <Button styleClass="outline-button" text="Go to OPS"/>
                            <Button styleClass="outline-button" text="Go to Finance"/>
                            <Button styleClass="outline-button" text="Go to Recruitment"/>
                        </HBox>
                    </VBox>

                    <!-- Hidden components for backward compatibility & preventing NullPointerExceptions in HelloController -->
                    <VBox visible="false" managed="false">
                        <TableView fx:id="coverageTrendTable"/>
                        <TableView fx:id="shrinkageAnalysisTable"/>
                        <TableView fx:id="liveMonitoringTable"/>
                        <ListView fx:id="recommendationsList"/>
                        <Label fx:id="agentsValueLabel"/>
                        <Label fx:id="slaRiskValueLabel"/>
                        <Label fx:id="alertsBadgeLabel"/>
                        <VBox fx:id="alertsContainer"/>
                        <Label fx:id="criticalAlertsLabel"/>
                        <Label fx:id="warningAlertsLabel"/>
                        <Label fx:id="infoAlertsLabel"/>
                        <Label fx:id="resolvedAlertsLabel"/>
                        <Label fx:id="pendingApprovalsBadgeLabel"/>
                        <Label fx:id="leaveRequestsLabel"/>
                        <Label fx:id="scheduleRequestsLabel"/>
                        <Label fx:id="overtimeRequestsLabel"/>
                        <VBox fx:id="warningsContainer"/>
                        <Label fx:id="warningsBadgeLabel"/>
                        <VBox fx:id="insightsContainer"/>
                        <VBox fx:id="feedCol1"/>
                        <VBox fx:id="feedCol2"/>
                        <VBox fx:id="feedCol3"/>
                        <Label fx:id="opsForecastLabel"/>
                        <Label fx:id="opsVolumeLabel"/>
                        <Label fx:id="opsBacklogLabel"/>
                        <Label fx:id="opsSlaBreachedLabel"/>
                        <StackPane fx:id="serviceGaugePane"/>
                        <StackPane fx:id="ahtGaugePane"/>
                        <StackPane fx:id="occupancyGaugePane"/>
                        <StackPane fx:id="shrinkageGaugePane"/>
                    </VBox>
                </VBox>
                    </content>
                </ScrollPane>

                <VBox fx:id="analyticsPage" spacing="16.0" visible="false" managed="false" styleClass="module-page">
                    <VBox spacing="10.0" styleClass="panel">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="panel-title" text="Individual Agent Reports"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button onAction="#onExportSelectedAgentClick" styleClass="outline-button" text="Download Selected Agent"/>
                            <Button onAction="#onExportAgentReportClick" styleClass="outline-button" text="Download All Agent Reports"/>
                        </HBox>
                        <Label fx:id="agentReportNoteLabel" styleClass="content-note" wrapText="true"/>
                        <TableView fx:id="agentReportTable" prefHeight="240.0" VBox.vgrow="ALWAYS"/>
                    </VBox>
                    <VBox spacing="10.0" styleClass="panel" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="panel-title" text="Working Hours Detail"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button onAction="#onExportWorkingHoursClick" styleClass="outline-button" text="Download"/>
                        </HBox>
                        <TableView fx:id="workingHoursTable" prefHeight="320.0" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </VBox>

                <VBox fx:id="leavePage" spacing="16.0" visible="false" managed="false" styleClass="module-page">
                    <VBox spacing="10.0" styleClass="panel" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="panel-title" text="Leave Coverage Reports"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button onAction="#onExportLeaveCoverageClick" styleClass="outline-button" text="Download"/>
                        </HBox>
                        <Label fx:id="leaveNoteLabel" styleClass="content-note" wrapText="true"/>
                        <TableView fx:id="leaveCoverageTable" prefHeight="560.0" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </VBox>

                <VBox fx:id="shrinkagePage" spacing="16.0" visible="false" managed="false" styleClass="module-page">
                    <VBox spacing="10.0" styleClass="panel" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="panel-title" text="Shrinkage Reports"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button onAction="#onExportShrinkageTableClick" styleClass="outline-button" text="Download"/>
                        </HBox>
                        <Label fx:id="shrinkageNoteLabel" styleClass="content-note" wrapText="true"/>
                        <TableView fx:id="shrinkageTable" prefHeight="560.0" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </VBox>
            </StackPane>

            <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="status-bar">
                <Label fx:id="statusLabel" text="WebSocket Connected"/>
                <Label text="gRPC Connected"/>
                <Label text="CSV Watcher Active"/>
                <Label text="Queue Listener Active"/>
                <Label text="API Health"/>
                <Label fx:id="apiStatusLabel" text="Healthy"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Active Users 142"/>
                <Label text="Environment Production"/>
                <Label text="Last Refresh 23 May 2026 10:24:36 AM"/>
                <Label text="System Status"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
