<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Main layout for the CSV table screen. -->
<VBox alignment="TOP_LEFT" spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sam.fxdemo.HelloController">
    <!-- Adds consistent spacing around the table view. -->
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Groups the upload button and current CSV loading status. -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <!-- Opens the file chooser so the user can upload a CSV file. -->
        <Button fx:id="uploadButton" text="Upload CSV" onAction="#onUploadButtonClick"/>

        <!-- Shows the selected file status and row count. -->
        <Label fx:id="statusLabel" text="No CSV file selected."/>

        <Button fx:id="apiStatusButton" text="Check API" onAction="#onApiStatusButtonClick"/>
        <Label fx:id="apiStatusLabel" text="FastAPI: starting"/>
    </HBox>

    <!-- Displays the CSV rows and columns created dynamically by the controller. -->
    <TableView fx:id="csvTable" prefHeight="580.0" prefWidth="1160.0"/>
</VBox>
